    } /* end pg_pin */
    pg_pin (VSS) {
      voltage_name : VSS ;
      pg_type : primary_ground ;
    } /* end pg_pin */
    pin (OUT) {
      direction : output ;
      function : "OUT = !(!A&B&C)" ;
      timing () {
        related_pin : A ;
